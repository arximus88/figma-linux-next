#!/usr/bin/make -f

export DH_VERBOSE=1
export DH_OPTIONS=-v

# override_dh_auto_clean:
# 	rm -rf ./debian/figma-linux

override_dh_auto_install:
	mkdir -p ./debian/figma-linux-next/opt/figma-linux-next
	mkdir -p ./debian/figma-linux-next/usr/share/applications
	mkdir -p ./debian/figma-linux-next/usr/share/icons/hicolor
	rsync -av --progress ./* ./debian/figma-linux-next/opt/figma-linux-next/ --exclude debian --exclude .pc --exclude resources/icon --exclude resources/figma-linux.desktop
	cp -rf ./figma-linux-next.desktop ./debian/figma-linux-next/usr/share/applications/
	chmod 755 ./debian/figma-linux-next/opt/figma-linux-next/figma-linux-next

	bash -c 'for file in ./resources/icons/*; do name=`basename $${file%.*}`; mkdir -p ./debian/figma-linux-next/usr/share/icons/hicolor/$${name}/apps; cp -rf "$$file" ./debian/figma-linux-next/usr/share/icons/hicolor/$${name}/apps/figma-linux-next.png; done'

	rm -rf ./resources/icons ./figma-linux-next.desktop

	xdg-mime default figma-linux-next.desktop x-scheme-handler/figma


override_dh_shlibdeps:

override_dh_builddeb:
	dpkg-deb --build debian/figma-linux-next ..

%:
	dh $@


# dh_make generated override targets
# This is example for Cmake (See https://bugs.debian.org/641051 )
