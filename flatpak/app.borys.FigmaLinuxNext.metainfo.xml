<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.borys.FigmaLinuxNext</id>

  <name>Figma Linux Next</name>
  <summary>Unofficial Figma desktop client for Linux</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-only</project_license>

  <developer id="app.borys">
    <name>Borys Kharchenko</name>
  </developer>

  <description>
    <p>
      Figma Linux Next is an unofficial, community-built desktop application that
      wraps the Figma web app with native Linux integration. It is not affiliated
      with, endorsed by, or sponsored by Figma, Inc.
    </p>
    <p>Features:</p>
    <ul>
      <li>Native Wayland support and GPU-accelerated WebGL canvas</li>
      <li>Hardware video decoding (VAAPI)</li>
      <li>Tabbed multi-window management</li>
      <li>System font integration</li>
      <li>Plugins/extensions with hot-reloading</li>
      <li>figma:// protocol handler and .fig file association</li>
    </ul>
  </description>

  <launchable type="desktop-id">app.borys.FigmaLinuxNext.desktop</launchable>

  <!-- Served from the dev branch, which is the stable release branch. Both files are
       tracked in images/; appstreamcli validation fails on an unreachable URL. -->
  <screenshots>
    <screenshot type="default">
      <caption>Editing a design, with the tab bar in GNOME frame style</caption>
      <image width="1403" height="857">https://raw.githubusercontent.com/arximus88/figma-linux-next/dev/images/screenshot1.jpg</image>
    </screenshot>
    <screenshot>
      <caption>Creating a file — each tab carries the icon of its Figma file type</caption>
      <image width="891" height="474">https://raw.githubusercontent.com/arximus88/figma-linux-next/dev/images/update_1.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://borys.app</url>
  <url type="bugtracker">https://github.com/arximus88/figma-linux-next/issues</url>
  <url type="vcs-browser">https://github.com/arximus88/figma-linux-next</url>

  <!-- Wraps a third-party web service whose content is not controlled by this app. -->
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">intense</content_attribute>
  </content_rating>

  <!-- Newest first; kept in step with package.json by scripts/sync_flatpak_release.py. -->
  <releases>
    <release version="0.16.0" date="2026-08-06"/>
    <release version="0.15.0" date="2026-07-01"/>
    <release version="0.14.0" date="2026-06-25"/>
  </releases>
</component>
