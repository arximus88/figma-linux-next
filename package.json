{
  "name": "figma-linux-next",
  "version": "0.13.7",
  "description": "Unofficial Electron-based browser wrapper for the Figma web app on Linux. Not affiliated with or endorsed by Figma, Inc.",
  "main": "dist/main/main.js",
  "repository": "https://github.com/arximus88/figma-linux-next.git",
  "homepage": "https://github.com/arximus88/figma-linux-next",
  "author": "Figma Linux Community",
  "license": "MIT",
  "scripts": {
    "start": "bun run build && bun run run",
    "dev": "cross-env NODE_ENV=dev vite",
    "run": "electron dist/main/main.js",
    "run:watch": "nodemon --watch dist/main --ext js,json --exec \"electron dist/main/main.js\"",
    "build": "bun run cln && vite build && node -e \"require('fs').cpSync('src/package.json','dist/package.json')\" && cd dist && bun install --production --no-save",
    "gen:changelog": "bun scripts/generate-changelog-data.ts",
    "builder": "electron-builder --config=config/builder.json -l",
    "pack": "rm -rf build/installers && bun run build && chmod a+x ./resources/AppRun && bun run builder",
    "pack:pacman": "bun run build && electron-builder --config=config/builder.json -l pacman",
    "package": "rm -rf build/installers && bun run build && electron-builder --config=config/builder.json -l",
    "local:install": "sudo rm -rf /opt/figma-linux-next && sudo mkdir -p /opt/figma-linux-next && sudo cp -rf ./build/installers/linux-unpacked/* /opt/figma-linux-next/",
    "test:unit": "bun test tests/unit/",
    "test:e2e": "ELECTRON_RUN_AS_NODE= ELECTRON_NO_ATTACH_CONSOLE= playwright test",
    "//": "bun test (combined) conflicts with e2e due to electron preload - use test:unit && test:e2e separately",
    "check": "svelte-check",
    "lp": "bun run lint & bun run prettier",
    "lint": "eslint src tests",
    "prettier": "prettier \"src/**/*.ts\" --write",
    "precommit": "lint-staged",
    "cln": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "chokidar": "^5.0.0",
    "css-vars": "^2.4.0",
    "electron-build-env": "^0.2.0",
    "electron-log": "^5.4.3",
    "fontkit": "^2.0.4",
    "tslib": "^2.8.1"
  },
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "^1.3.13",
    "@types/fontkit": "^2.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.2",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.59.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vite-plugin-require": "^1.2.17",
    "yallist": "^5.0.0"
  },
  "overrides": {
    "hosted-git-info": "^7"
  },
  "keywords": [
    "Figma",
    "linux",
    "Electron",
    "desktop",
    "app"
  ]
}
