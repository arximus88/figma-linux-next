{
  "name": "figma-linux-test",
  "version": "0.12.0",
  "description": "Optimized Figma desktop application for Linux with native Wayland support, GPU acceleration, and system integration.",
  "main": "src/main/index.ts",
  "repository": "https://github.com/arximus88/figma-linux-next.git",
  "homepage": "https://github.com/arximus88/figma-linux-next",
  "author": "Figma Linux Community",
  "license": "MIT",
  "scripts": {
    "start": "bun run build && bun run run",
    "dev": "bun run rollup:dev",
    "run": "electron dist/main/main.js",
    "run:watch": "nodemon --config ./config/nodemon.json",
    "rollup": "rollup -c ./config/rollup.renderer.config.js",
    "rollup:main": "rollup -c ./config/rollup.main.config.js",
    "rollup:dev": "bun run rollup:main & bun run rollup:watch",
    "rollup:watch": "rollup -c ./config/rollup.renderer.config.js -w",
    "build": "bun run cln && bun run rollup:main & bun run rollup & wait && cd dist && bun install --production --no-save",
    "builder": "electron-builder --config=config/builder.json -l",
    "pack": "rm -rf build/installers && bun run build && chmod a+x ./resources/AppRun && bun run builder",
    "pack:pacman": "bun run build && electron-builder --config=config/builder.json -l pacman",
    "package": "rm -rf build/installers && bun run build && electron-builder --config=config/builder.json -l",
    "local:install": "sudo rm -rf /opt/figma-linux && sudo mkdir -p /opt/figma-linux && sudo cp -rf ./build/installers/linux-unpacked/* /opt/figma-linux/",
    "check": "svelte-check",
    "lp": "bun run lint & bun run prettier",
    "lint": "eslint -c ./config/.eslintrc.js src/**/*.ts",
    "prettier": "prettier src/{**/,*/**/,**/**/**/,**/**/**/**/,**/**/**/**/**/,**/**/**/**/**/**/}*.ts --write",
    "precommit": "lint-staged",
    "cln": "rm -rf ./dist"
  },
  "lint-staged": {
    "*.{ts, tsx, js, jsx}": [
      "node_modules/.bin/eslint -c ./config/.eslintrc.js src/**/*.ts",
      "node_modules/.bin/prettier src/{**/,*/**/,**/**/**/,**/**/**/**/,**/**/**/**/**/,**/**/**/**/**/**/}*.ts --write",
      "git add"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chokidar": "^4.0.3",
    "css-vars": "^2.4.0",
    "electron-build-env": "^0.2.0",
    "fontkit": "^2.0.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/adm-zip": "^0.5.7",
    "@types/fontkit": "^2.0.8",
    "@types/lodash": "^4.17.23",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.19.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "dotenv": "^16.6.1",
    "electron": "^39.6.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-dev": "^2.1.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^5.51.2",
    "svelte-check": "^4.4.0",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "Figma",
    "linux",
    "Electron",
    "desktop",
    "app"
  ]
}
