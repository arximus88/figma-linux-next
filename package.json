{
  "name": "figma-linux-next",
  "version": "0.13.0",
  "description": "Unofficial Electron-based browser wrapper for the Figma web app on Linux. Not affiliated with or endorsed by Figma, Inc.",
  "main": "dist/main/main.js",
  "repository": "https://github.com/arximus88/figma-linux-next.git",
  "homepage": "https://github.com/arximus88/figma-linux-next",
  "author": "Figma Linux Community",
  "license": "MIT",
  "scripts": {
    "start": "bun run build && bun run run",
    "dev": "cross-env NODE_ENV=dev vite",
    "run": "electron dist/main/main.js",
    "run:watch": "nodemon --watch dist/main --ext js,json --exec \"electron dist/main/main.js\"",
    "build": "bun run cln && vite build && node -e \"require('fs').cpSync('src/package.json','dist/package.json')\" && cd dist && bun install --production --no-save",
    "builder": "electron-builder --config=config/builder.json -l",
    "pack": "rm -rf build/installers && bun run build && chmod a+x ./resources/AppRun && bun run builder",
    "pack:pacman": "bun run build && electron-builder --config=config/builder.json -l pacman",
    "package": "rm -rf build/installers && bun run build && electron-builder --config=config/builder.json -l",
    "local:install": "sudo rm -rf /opt/figma-linux && sudo mkdir -p /opt/figma-linux && sudo cp -rf ./build/installers/linux-unpacked/* /opt/figma-linux/",
    "test:unit": "bun test src/",
    "test:e2e": "playwright test",
    "test": "bun test src/ && playwright test",
    "check": "svelte-check",
    "lp": "bun run lint & bun run prettier",
    "lint": "eslint -c ./config/.eslintrc.js src/**/*.ts",
    "prettier": "prettier \"src/**/*.ts\" --write",
    "precommit": "lint-staged",
    "cln": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\""
  },
  "lint-staged": {
    "*.{ts, tsx, js, jsx}": [
      "node_modules/.bin/eslint -c ./config/.eslintrc.js src/**/*.ts",
      "node_modules/.bin/prettier \"src/**/*.ts\" --write",
      "git add"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chokidar": "^5.0.0",
    "css-vars": "^2.4.0",
    "electron-build-env": "^0.2.0",
    "electron-log": "^5.4.3",
    "fontkit": "^2.0.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "^1.3.11",
    "@types/fontkit": "^2.0.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "25",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "svelte": "^5.55.0",
    "svelte-check": "^4.4.5",
    "svelte-preprocess": "^6.0.3",
    "typescript": "6",
    "vite": "^8.0.2",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-require": "^1.2.14",
    "yallist": "5"
  },
  "keywords": [
    "Figma",
    "linux",
    "Electron",
    "desktop",
    "app"
  ]
}
